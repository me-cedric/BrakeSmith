{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrakeSmith Desktop",
  "version": "0.5.1",
  "identifier": "io.github.me-cedric.brakesmith",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BrakeSmith Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0a0c0e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/brakesmith"],
    "shortDescription": "Safety-first H.265 library transcoding",
    "longDescription": "Optional cross-platform desktop interface for BrakeSmith CLI.",
    "category": "Utility",
    "copyright": "Copyright Cedric Meyer",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
